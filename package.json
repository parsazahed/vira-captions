{
  "name": "vira-captions",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "description": "An open-source, Farsi-first subtitle studio for Adobe Premiere Pro.",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && node scripts/package.mjs",
    "typecheck": "tsc -b",
    "test": "vitest run --exclude tests/e2e/**",
    "format": "prettier --write src tests scripts *.json *.md",
    "format:check": "prettier --check src tests scripts *.json *.md",
    "preview": "vite preview --host 127.0.0.1",
    "install:cep": "node scripts/install.mjs",
    "test:e2e": "playwright test",
    "package:mac": "npm run build && node scripts/package-mac.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.2.0",
    "@fontsource-variable/vazirmatn": "^5.2.0",
    "ffmpeg-static": "^5.2.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "prettier": "^3.6.0",
    "typescript": "^5.9.0",
    "vite": "^6.4.0",
    "vitest": "^5.0.5"
  }
}
